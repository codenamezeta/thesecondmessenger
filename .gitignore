# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm content-addressable store. Sometimes created locally (instead of
# in the shared global store at ~/.local/share/pnpm/store) when pnpm
# detects a cross-filesystem boundary — common on WSL. It's a rebuildable
# cache; never commit it.
/.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env*.local
.env
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# cursor
.cursor/*
.vercel

# Gated content: keep small audio/art in-repo; videos belong in Payload storage or Git LFS
gated-content/**/*.MP4
gated-content/**/*.mp4
gated-content/**/*.mov
gated-content/**/*.MOV
